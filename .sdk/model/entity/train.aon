# Entity: train

main: kit: entity: train: {

  alias: field: {}

  fields: [
    {
      name: "currentStation"
      req: false
      short: "Current station where the train is located or last reported position"
      type: "`$STRING`"
    }
    {
      name: "delay"
      req: false
      short: "Delay in minutes (positive for late, negative for early, 0 for on time)"
      type: "`$INTEGER`"
    }
    {
      name: "destination"
      req: false
      short: "Destination station of the train"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "lastUpdated"
      req: false
      short: "Timestamp of the last position update"
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "latitude"
      req: false
      short: "Current latitude coordinate of the train"
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "longitude"
      req: false
      short: "Current longitude coordinate of the train"
      type: "`$NUMBER`"
    }
    {
      name: "source"
      req: false
      short: "Source station of the train"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Current status of the train"
      type: "`$STRING`"
    }
    {
      name: "trainName"
      req: false
      short: "Name of the train"
      type: "`$STRING`"
    }
    {
      name: "trainNumber"
      req: false
      short: "Unique identifier for the train"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "train"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api/trains"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "trains"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "10103"
                kind: "param"
                name: "id"
                orig: "train_number"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/trains/{trainNumber}"
          rename: {
            param: {
              trainNumber: "id"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "trains"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
